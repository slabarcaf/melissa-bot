# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Task API (task-dashboard backend)
TASK_API_BASE=https://your-task-dashboard.vercel.app
TASK_API_SECRET=your_task_api_secret_here

# Google OAuth (for Gmail + Calendar)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_personal_gmail_refresh_token
GOOGLE_REFRESH_TOKEN_BERKELEY=your_berkeley_gmail_refresh_token

# Google Sheets workflows (Finanzas + Networking)
# Berkeley refresh token must include the Sheets scope (auth/spreadsheets)
FINANCE_SHEET_ID=your_finance_ledger_spreadsheet_id
NETWORK_SHEET_ID=your_network_tracker_spreadsheet_id

# MCP server paths (defaults to /root/.openclaw/skills/ if not set)
TASKS_MCP_PATH=/path/to/tasks-mcp.js
CALENDAR_MCP_PATH=/path/to/calendar-mcp.js
SHEETS_MCP_PATH=/path/to/sheets-mcp.js

# Optional: override config.json path (legacy mode)
# CFG_PATH=/root/whatsapp-bot/config.json
